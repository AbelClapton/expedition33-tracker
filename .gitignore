# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# scratch checkout the Pages deploy pushes from
/.pages-work/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# editor-local MCP server config - holds API keys, this repo is public
.vscode/mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo

# third-party map artwork - fetched at runtime by /api/tile (and future region maps),
# cached locally, deliberately not redistributed via the repo
/public/tiles/
/public/regions/
next-env.d.ts
